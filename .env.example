# Solana RPC used by the treasury balance check and the launchpad (client-exposed)
NEXT_PUBLIC_SOLANA_RPC=https://mainnet.helius-rpc.com/?api-key=YOUR_KEY

# Public treasury / impact vault wallet
NEXT_PUBLIC_TREASURY_WALLET=FN7mbeChbKQoVM3Wvctw7aLgVW3eSM1ZAo74b4NgkeAz

# Immutable Meteora DBC pool config for the launchpad.
# Created ONCE via: KEYPAIR=path\to\keypair.json node scripts/create-dbc-config.mjs
# Until this is set, /launch shows the flow but launching is disabled.
NEXT_PUBLIC_DBC_CONFIG_KEY=
