# Copy to .env.local for local dev; set the same names on Vercel.
# Never prefix a secret with NEXT_PUBLIC_ - those ship to the browser.

# --- Server-only secrets ---

# Helius RPC key. Read only by server code (lib/rpc-server.ts) and operator
# scripts (scripts/lib/rpc.mjs). The browser goes through /api/rpc instead.
HELIUS_API_KEY=
# Optional full RPC URL override for server code (takes precedence).
# RPC_URL=

# Secret for the operator claims console at /admin. Any long random string.
ADMIN_KEY=

# Anthropic key for the launch helper (/api/ai/launch-helper).
ANTHROPIC_API_KEY=

# Vercel Blob store for token images (/api/upload).
BLOB_READ_WRITE_TOKEN=
BLOB_BASE_URL=

# --- Public (shipped to the browser) ---

# Public treasury / impact vault wallet
# (treasury address lives in lib/constants.ts - no env var)

# Immutable Meteora DBC pool config for the launchpad.
# Created ONCE via: KEYPAIR=path\to\keypair.json CONFIRM=1 node scripts/create-dbc-config.mjs
# Until this is set, /launch shows the flow but launching is disabled.
# Inlined at build time: changing it on Vercel needs a redeploy.
NEXT_PUBLIC_DBC_CONFIG_KEY=

# $SOW mint address. Leave empty until launch - the site hides the
# contract-address block while it is empty. Needs a redeploy when set.
NEXT_PUBLIC_SOW_MINT=
# Streamflow lock link for the $SOW team buy (tokenomics page links it; set after launch)
NEXT_PUBLIC_SOW_LOCK_URL=
